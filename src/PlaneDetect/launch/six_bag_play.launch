<?xml version="1.0"?>
<launch>
  <!--
    /use_sim_time 是全局 rosparam，不能给「单个节点」单独关掉 sim；要与 bag 同屏看 PCD，
    须在同一 master 下让 bag1 的 clock 推进时间，再启 pcd_to_pointcloud（见下方 publish_pcd）。
  -->
  <!-- catkin 下 $(find PlaneDetect) 常为 devel/share/PlaneDetect，需 ../../../ 才到工作空间根 -->
  <arg name="workspace_root" default="$(find PlaneDetect)/../../.." />
  <arg name="bag1" default="$(arg workspace_root)/1.bag" />
  <arg name="bag2" default="$(arg workspace_root)/2.bag" />
  <arg name="bag3" default="$(arg workspace_root)/3.bag" />
  <arg name="bag4" default="$(arg workspace_root)/4.bag" />
  <arg name="bag5" default="$(arg workspace_root)/5.bag" />
  <arg name="bag6" default="$(arg workspace_root)/6.bag" />
  <!-- 仅 bag1 发 /clock；其余 5 路勿加 clock 参数，避免争抢 -->
  <arg name="use_sim_time" default="true" />
  <!-- 六袋若不在同一 rostime 轴上录制，可改为 false -->
  <arg name="launch_rviz" default="true" />

  <!-- 工作空间根目录下的 raw.pcd，与六路 bag 同时发布，共用 /clock -->
  <arg name="publish_pcd" default="true" />
  <arg name="pcd_file" default="$(arg workspace_root)/raw.pcd" />
  <arg name="pcd_interval" default="1.0" />
  <arg name="pcd_frame_id" default="map" />
  <arg name="pcd_topic" default="/cloud_pcd" />

  <param name="/use_sim_time" value="$(arg use_sim_time)" />

  <node pkg="rosbag" type="play" name="rosbag_play_bag1" output="screen"
        args="--clock $(arg bag1) /plane_markers:=/bag1/plane_markers /quadric_markers:=/bag1/quadric_markers" />

  <node pkg="rosbag" type="play" name="rosbag_play_bag2" output="screen"
        args="$(arg bag2) /plane_markers:=/bag2/plane_markers /quadric_markers:=/bag2/quadric_markers" />

  <node pkg="rosbag" type="play" name="rosbag_play_bag3" output="screen"
        args="$(arg bag3) /plane_markers:=/bag3/plane_markers /quadric_markers:=/bag3/quadric_markers" />

  <node pkg="rosbag" type="play" name="rosbag_play_bag4" output="screen"
        args="$(arg bag4) /plane_markers:=/bag4/plane_markers /quadric_markers:=/bag4/quadric_markers" />

  <node pkg="rosbag" type="play" name="rosbag_play_bag5" output="screen"
        args="$(arg bag5) /plane_markers:=/bag5/plane_markers /quadric_markers:=/bag5/quadric_markers" />

  <node pkg="rosbag" type="play" name="rosbag_play_bag6" output="screen"
        args="$(arg bag6) /plane_markers:=/bag6/plane_markers /quadric_markers:=/bag6/quadric_markers" />

  <group if="$(arg publish_pcd)">
    <node pkg="pcl_ros" type="pcd_to_pointcloud" name="pcd_to_pointcloud"
          args="$(arg pcd_file) $(arg pcd_interval)"
          output="screen">
      <param name="frame_id" value="$(arg pcd_frame_id)" />
      <param name="latch" value="true" />
      <remap from="cloud_pcd" to="$(arg pcd_topic)" />
    </node>
  </group>

  <node if="$(arg launch_rviz)" name="rviz" pkg="rviz" type="rviz"
        args="-d $(find PlaneDetect)/config/six_bag_markers.rviz"
        output="screen" />
</launch>
